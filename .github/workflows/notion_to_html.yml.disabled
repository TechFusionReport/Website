name: Notion to HTML Sync (Only on Changes)

on:
  schedule:
    - cron: '0 * * * *'  # Check for changes every hour
  workflow_dispatch:  # Allows manual trigger

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Set up environment
        env:
          NOTION_TOKEN: ${{ secrets.NOTION_TOKEN }}

      - name: Run Notion fetch script
        run: python notion_fetch.py
      
      - name: Check for Changes
        id: check_changes
        run: |
          git add data.json
          git diff --quiet && echo "No changes detected, skipping commit." || echo "Changes found!"

      - name: Commit and Push (If Changed)
        if: steps.check_changes.outputs.exit_code != 0
        run: |
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          git commit -m "Auto-update Notion data"
          git push
